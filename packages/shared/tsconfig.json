{
    "compilerOptions": {
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "types": ["node"],
        "module": "esnext",
        "target": "es2022",
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "declaration": true,
        "preserveSymlinks": true
    },
    "include": ["src"],
    "exclude": ["dist"]
}
